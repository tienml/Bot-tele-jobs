# Sao chép file này thành .env và điền thông tin thực.
# Bot sẽ đọc file này tự động khi khởi động.

# Token lấy từ @BotFather trên Telegram (bắt buộc)
BOT_TOKEN=your_token_here

# Giờ gửi tin hàng ngày (24h, múi giờ Việt Nam)
DAILY_HOUR=8
DAILY_MINUTE=0

# Số job tiềm năng nhất hiển thị kèm nút bấm (mặc định 5)
TOP_N=5

# Job cũ hơn số ngày này bị loại (mặc định 21)
MAX_AGE_DAYS=21
